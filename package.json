{
  "name": "rbshift-pwa",
  "private": true,
  "version": "1.3.19",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node --test",
    "lint:hooks": "eslint . --quiet",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:driver": "node scripts/smoke-driver.mjs",
    "verify": "node --test && node ./node_modules/vite/bin/vite.js build && corepack pnpm audit --prod",
    "generate:vapid": "npx web-push generate-vapid-keys"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
